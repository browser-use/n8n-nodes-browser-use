{
	"name": "n8n-nodes-browser-use-cloud",
	"version": "1.2.0",
	"description": "n8n node for Browser Use Cloud API v4, v3, and v2 - agent runs, sessions, and cloud browsers",
	"keywords": [
		"n8n-community-node-package",
		"browser-automation",
		"ai-agent",
		"web-scraping",
		"browser-use"
	],
	"license": "MIT",
	"homepage": "https://github.com/browser-use/n8n-nodes-browser-use",
	"author": {
		"name": "Browser Use Team",
		"email": "support@browser-use.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/browser-use/n8n-nodes-browser-use.git"
	},
	"engines": {
		"node": ">=22.22",
		"pnpm": ">=9.1"
	},
	"packageManager": "pnpm@9.1.0",
	"main": "index.js",
	"scripts": {
		"build": "n8n-node build && gulp build:icons",
		"dev": "n8n-node dev",
		"format": "prettier nodes credentials test --write",
		"format:check": "prettier nodes credentials test --check",
		"lint": "n8n-node lint",
		"lintfix": "n8n-node lint --fix",
		"test": "node --test \"test/*.test.js\"",
		"prepublishOnly": "pnpm build && pnpm lint && pnpm test"
	},
	"files": [
		"dist",
		"index.js",
		"CHANGELOG.md"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/BrowserUseApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/BrowserUse/BrowserUse.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.29.0",
		"@typescript-eslint/eslint-plugin": "^8.59.2",
		"@typescript-eslint/parser": "^8.59.2",
		"eslint": "^8.57.1",
		"eslint-plugin-n8n-nodes-base": "^1.16.6",
		"gulp": "^5.0.1",
		"n8n-workflow": "^2.16.0",
		"prettier": "^3.8.3",
		"typescript": "~5.7.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"pnpm": {
		"overrides": {
			"ajv@^6.0.0": "6.15.0",
			"@langchain/community": "1.1.28",
			"axios": "1.19.0",
			"brace-expansion@^1.0.0": "1.1.18",
			"brace-expansion@^2.0.0": "2.1.4",
			"brace-expansion@^5.0.0": "5.0.9",
			"braces": "3.0.3",
			"flatted": "3.4.2",
			"follow-redirects": "1.16.0",
			"form-data": "4.0.6",
			"js-yaml": "4.3.1",
			"langsmith": "0.6.1",
			"lodash": "4.18.1",
			"minimatch@^3.0.0": "3.1.5",
			"minimatch@^9.0.0": "9.0.9",
			"micromatch": "4.0.8",
			"picomatch@^2.0.0": "2.3.2",
			"tmp": "0.2.7",
			"undici@^6.0.0": "6.28.0",
			"uuid@^10.0.0": "11.1.1",
			"ws@^8.0.0": "8.21.3"
		}
	}
}
